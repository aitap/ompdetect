# without any warranty.

: > config.log

log () {
	printf "$@" | tee -a config.log
}

test_openmp () {
	# --preclean is not enough; remove the DLL too
	# otherwise Make may assume that the same-second object file is not newer than the previously built DLL
	"${R_HOME}"/bin/Rscript -e 'unlink(paste0("test", .Platform$dynlib.ext))'

	CFLAGS="${PKG_CFLAGS:+${PKG_CFLAGS} }$1"
	LIBS="${PKG_LIBS:+${PKG_LIBS} }$2"
	log "* checking if OpenMP works with PKG_CFLAGS='%s' PKG_LIBS='%s'... " "$CFLAGS" "$LIBS"
	if ! PKG_CFLAGS="$CFLAGS" PKG_LIBS="$LIBS" "${R_HOME}"/bin/R CMD SHLIB --preclean --clean test.c >>config.log 2>&1; then
		log "failed to build\n"
		return 1
	fi

	if ! "${R_HOME}"/bin/Rscript -e '
dll <- paste0("test", .Platform$dynlib.ext)
dyn.load(dll)
ans <- .C("test_openmp", ans = integer(1))$ans
stopifnot(identical(ans, 3L))
' >> config.log 2>&1; then
		log "failed to run\n"
		return 1
	fi

	OMP_CFLAGS="$1"
	OMP_LIBS="$2"
	log "yes\n"
	return 0
}

guess_openmp_macos () {
	test_openmp "" "" \
	|| \
	test_openmp "-Xclang -fopenmp" "-lomp" \
	|| \
	test_openmp '$(SHLIB_OPENMP_CFLAGS)' '$(SHLIB_OPENMP_CFLAGS)' \
	&& return

	if test_openmp "-Xclang -fopenmp" "/usr/local/lib/libomp.dylib"; then
		log "Since an earlier test for -lomp failed, the resulting package is probably unsafe to mix with CRAN binaries!\n"
		return
	fi

	log "Couldn't guess a working OpenMP configuration.\n"
	log "Do you need an OpenMP runtime and headers from <https://mac.r-project.org/openmp/>?\n"
	OMP_CFLAGS=""
	OMP_LIBS=""
}

log "Variables from the environment: PKG_CFLAGS='%s' PKG_LIBS='%s'\n" "$PKG_CFLAGS" "$PKG_LIBS"

case "$(uname)" in
Darwin)
	log "Guessing OpenMP configuration for macOS\n"
	cat >"test.c" <<'EOF'
#ifdef _OPENMP
#include <omp.h> /* Sometimes the runtime is fine, but there's no header. */
#endif
void test_openmp(int * result) {
 int sum = 0;
#ifdef _OPENMP
 /* Sometimes compile-, link-, and load-tests are not enough.
 ** So actually try to run an OpenMP loop. */
 #pragma omp parallel for reduction(+:sum) num_threads(2) schedule(dynamic)
 for (int i = 1; i <= 2; ++i) sum += i;
#endif
 *result = sum;
}
EOF
	guess_openmp_macos
	rm -f test.*
	;;
*)
	OMP_CFLAGS='$(SHLIB_OPENMP_CFLAGS)'
	OMP_LIBS='$(SHLIB_OPENMP_CFLAGS)'
	;;
esac

CFLAGS="${PKG_CFLAGS:+${PKG_CFLAGS} }${OMP_CFLAGS}"
LIBS="${PKG_LIBS:+${PKG_LIBS} }${OMP_LIBS}"
log "Adding PKG_CFLAGS='%s', PKG_LIBS='%s'\n" "$CFLAGS" "$LIBS"
sed \
	-e "s|@CONFIGURE_CFLAGS@|${CFLAGS}|" \
	-e "s|@CONFIGURE_LIBS@|${LIBS}|" \
	src/Makevars.in > src/Makevars
