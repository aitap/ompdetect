#!/bin/sh
: > config.log

log () {
	printf "$@" | tee -a config.log
}

test_openmp () {
	log "* checking if OpenMP works with CFLAGS=%s LIBS=%s... " "$1" "$2"
	cat >"test.c" <<'EOF'
void test_openmp(int * result) {
 int sum = 0;
#ifdef _OPENMP
 /* Sometimes compile-, link-, and load-tests are not enough.
 ** So actually try to run an OpenMP loop. */
 #pragma omp parallel for reduction(+:sum) num_threads(2) schedule(dynamic)
 for (int i = 1; i <= 2; ++i) sum += i;
#endif
 *result = sum;
}
EOF
	if ! PKG_CFLAGS="$1" PKG_LIBS="$2" "${R_HOME}"/bin/R CMD SHLIB --preclean --clean test.c >>config.log 2>&1; then
		log "no\n"
		return 1
	fi
	rm -f test.c

	if ! "${R_HOME}"/bin/Rscript -e '
dll <- paste0("test", .Platform$dynlib.ext)
dyn.load(dll)
ans <- .C("test_openmp", ans = integer(1))$ans
stopifnot(identical(ans, 3L))
' >> config.log 2>&1; then
		log "no\n"
		return 1
	fi

	OMP_CFLAGS="$1"
	OMP_LIBS="$2"
	log "yes\n"
	return 0
}

case "$(uname)" in
Darwin)
	log "Guessing OpenMP configuration for macOS\n"
	test_openmp '$(SHLIB_OPENMP_CFLAGS)' '$(SHLIB_OPENMP_CFLAGS)' || \
	test_openmp "-Xclang -fopenmp" "-lomp" || \
	{ OMP_CFLAGS=""; OMP_LIBS=""; }
	rm -f test.*
	;;
*)
	OMP_CFLAGS='$(SHLIB_OPENMP_CFLAGS)'
	OMP_LIBS='$(SHLIB_OPENMP_CFLAGS)'
	;;
esac

log "Using CFLAGS=%s, LIBS=%s for OpenMP\n" "${OMP_CFLAGS}" "${OMP_LIBS}"
sed \
	-e "s/@CONFIGURE_OPENMP_CFLAGS@/${OMP_CFLAGS}/" \
	-e "s/@CONFIGURE_OPENMP_LIBS@/${OMP_LIBS}/" \
	src/Makevars.in > src/Makevars
